#!/usr/bin/env bash
# true-north pre-commit: validate the governed layers; run validator tests when
# anything under tools/ changed. Kept fast (<5s). Installed via `make hooks`.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

uv run python -m tools.validate

if git diff --cached --name-only | grep -q '^tools/'; then
    uv run pytest tools/tests/test_validators.py -q
fi
