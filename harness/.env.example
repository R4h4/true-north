# --- Model backend: set EXACTLY ONE of the two blocks ---

# Dev: OpenAI platform (works today with a personal key)
OPENAI_API_KEY=
# MODEL_ID=gpt-5.5            # default when OPENAI_API_KEY is set
# OPENAI_BASE_URL=            # leave unset for api.openai.com

# Prod: Bedrock Mantle (uncomment when switching; unset OPENAI_API_KEY)
# BEDROCK_MANTLE_REGION=us-east-1
# MODEL_ID=openai.gpt-5.5     # verify exact id via `aws bedrock list-foundation-models`

# --- Langfuse (optional locally; required for the DoD trace checks) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Governed CLI + demo guards ---
GOVERNED_CLI_CMD="uv run tn"
MAX_TURNS_PER_SESSION=20
DAILY_TOKEN_BUDGET=2000000
